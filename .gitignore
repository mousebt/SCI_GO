# Temporary and generated files
**/tmp/*
!**/tmp/.gitkeep
**/.cache/
**/_render/
**/_extract/
**/~$*
*.tmp
*.bak

# Python and editors
__pycache__/
*.py[cod]
.venv/
venv/
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local secrets and machine-specific environment
.env
.env.*
!.env.example

# Large local research data should be referenced, not committed
**/data-local/

# Submission build outputs; final approved files are explicitly force-added if needed
**/07_submission/build/

# User drop zone: raw intake materials are not committed automatically
START_HERE/*
!START_HERE/README.md
!START_HERE/PROJECT_INFO.md
